{
  "name": "ongaku-source",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Musik-In source: Telegram bot, katalog, dan signed audio stream API.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "bot": "node --import ./scripts/register-alias.mjs scripts/telegram-bot.mjs",
    "bot:once": "node --import ./scripts/register-alias.mjs scripts/telegram-bot.mjs --exit-when-idle=300 --max-runtime=4800",
    "catalog": "node --import ./scripts/register-alias.mjs scripts/build-catalog-from-bot.mjs",
    "catalog:resend": "node --import ./scripts/register-alias.mjs scripts/build-catalog-from-bot.mjs --resend"
  },
  "dependencies": {
    "@coflyn/scrapr": "1.3.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
